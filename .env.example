# Net Monitor Pro — 环境变量示例
# 复制为 .env 并按需修改；.env 已在 .gitignore 中忽略，切勿提交真实密钥。
# 说明：Django 默认不自动读取 .env，可用 python-dotenv 或在启动前 export/设置环境变量。

# ---- Django 核心 ----
# 生产环境必须替换为随机密钥，生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 调试开关：生产环境务必设为 False
DJANGO_DEBUG=True

# 允许访问的主机（逗号分隔）；留空时默认 localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- 网络监控 ----
# 抓包网卡名称；留空则由 scapy 自动选择默认网卡。
# 常见取值：Linux/WSL 多为 eth0，macOS 多为 en0，Windows 为网卡友好名。
NET_MONITOR_IFACE=
